<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件布局（RemoteViews 只支持基础控件）：颜色由 Provider 按主题动态设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#0A0A0B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="口袋私教 · 今日"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_deficit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="40sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_deficit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="今日热量差\n(大卡)"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_numbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="消耗 -- · 摄入 --"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="打开 App 看看今天"
        android:textSize="13sp" />
</LinearLayout>
